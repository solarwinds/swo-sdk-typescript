# @solarwinds/swo-sdk-typescript SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: SWO_
#
# Security environment variables:
SWO_API_TOKEN=your_apitoken_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
SWO_DEBUG=true
